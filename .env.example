# Copy to .env.local for local dev. On Railway, set these in the service variables.

# Postgres connection string. Railway injects this automatically for its Postgres plugin.
DATABASE_URL=postgres://user:password@localhost:5432/baby_tracker

# SSL is auto-detected: OFF for *.railway.internal and localhost, ON otherwise.
# Only set this to override — "false" to force off, "true" to force on.
# (Railway deployed via the internal URL needs no SSL; the public proxy URL does.)
# PGSSL=false

# Secret used to sign session JWTs. Generate one: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# App base URL fallback. Invite/reset links are normally built from the request
# host; this is only used when that's unavailable.
APP_URL=http://localhost:3000

# Email (Resend). Optional — without RESEND_API_KEY, invites/resets still work
# but the link is logged instead of emailed (copy it from Settings / the logs).
# Get a key at https://resend.com. EMAIL_FROM must be a verified domain in prod;
# the default onboarding@resend.dev only delivers to your own Resend account.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Nestling <hello@yourdomain.com>
