# Copy to .env.local for local dev. On Railway, set these in the service variables.

# Postgres connection string. Railway injects this automatically for its Postgres plugin.
DATABASE_URL=postgres://user:password@localhost:5432/baby_tracker

# SSL is auto-detected: OFF for *.railway.internal and localhost, ON otherwise.
# Only set this to override — "false" to force off, "true" to force on.
# (Railway deployed via the internal URL needs no SSL; the public proxy URL does.)
# PGSSL=false

# Secret used to sign session JWTs. Generate one: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# App base URL, used to build invite links.
APP_URL=http://localhost:3000
